{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/integrity/**/*.ts", "!src/integrity/tests/**"],
  "testRunner": "vitest",
  "mutator": "typescript",
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "reporters": ["html", "json", "clear-text"]
}
